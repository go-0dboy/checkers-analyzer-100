{
  "name": "stokeletka",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "node scripts/verify-scan.mjs && npm run typecheck && npm test && npm run build && node scripts/verify-release.mjs",
    "build:scan": "bash scripts/build-scan.sh",
    "build:apk": "bash scripts/build-apk.sh",
    "format:check": "prettier --check \"src/engine/*.ts\" \"src/state/*.ts\" \"tests/**/*.{ts,tsx}\" \"*.config.ts\" scripts/apply-icons.mjs package.json .github/workflows/build-apk.yml",
    "benchmark:search": "node scripts/benchmark-search.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.3.5",
    "vitest": "^5.0.4"
  },
  "version": "0.3.0",
  "engines": {
    "node": ">=22.18.0"
  }
}
